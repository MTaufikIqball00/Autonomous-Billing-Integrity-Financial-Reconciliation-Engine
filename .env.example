# ==============================================================================
# ABIFR — Agentic Billing Integrity & Financial Reconciliation
# Environment Configuration Template (NEVER commit real secrets!)
# ==============================================================================

# --- Isolated Service Ports ---
FRONTEND_PORT=14300
BACKEND_PORT=14800
DOC_INTEL_PORT=14900
POSTGRES_PORT=14543
REDIS_PORT=14637

# --- Hosts ---
FRONTEND_HOST=127.0.0.1
BACKEND_HOST=127.0.0.1
DOC_INTEL_HOST=127.0.0.1
POSTGRES_HOST=127.0.0.1

# --- PostgreSQL Configuration ---
POSTGRES_USER=abifr_app
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_DEV_PASSWORD
POSTGRES_DB=abifr
DATABASE_URL=postgres://abifr_app:CHANGE_ME_LOCAL_DEV_PASSWORD@127.0.0.1:14543/abifr

# --- Optional Redis Configuration (leave empty to use PostgreSQL durable queue) ---
REDIS_URL=

# --- Security & Authentication ---
# Generate with: openssl rand -hex 32 (or PowerShell random bytes)
JWT_SECRET=CHANGE_ME_MIN_32_CHARS_RANDOM_SECRET_KEY
DOC_INTEL_INTERNAL_TOKEN=CHANGE_ME_INTERNAL_WORKER_SHARED_TOKEN
COOKIE_SECURE=false

# --- Initial Bootstrap Accounts (used only if users table is empty on first startup) ---
BOOTSTRAP_ADMIN_EMAIL=admin@abifr.local
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_INITIAL_ADMIN_PASSWORD
BOOTSTRAP_REVIEWER_PASSWORD=CHANGE_ME_INITIAL_REVIEWER_PASSWORD
BOOTSTRAP_ANALYST_PASSWORD=CHANGE_ME_INITIAL_ANALYST_PASSWORD
BOOTSTRAP_AUDITOR_PASSWORD=CHANGE_ME_INITIAL_AUDITOR_PASSWORD

# --- Document Storage & Limits ---
STORAGE_DIR=./storage
MAX_UPLOAD_BYTES=26214400

# --- Document Intelligence & AI Provider Policy ---
DOC_INTEL_URL=http://127.0.0.1:14900
DOC_INTEL_TIMEOUT_SECS=60
# Allowed: local_deterministic | openai | gemini
AI_PROVIDER=local_deterministic
# External model egress is DISABLED by default for financial data protection
ENABLE_EXTERNAL_AI=false
REDACT_BEFORE_EXTERNAL_AI=true
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=

# --- Frontend Public API Endpoint ---
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:14800/api/v1

# --- Logging ---
RUST_LOG=abifr_backend=info,tower_http=info,sqlx=warn
